/* Centered navigation controls: pink outline in inactive state, gradient active. */


/* ===============================================================
   MENU AND TAB EDGE REFINEMENT
   =============================================================== */

/* Left menu: discreet outer border, matching the Patient ID card. */

/* Regular navigation buttons: neutral at rest, rose on hover, gradient active. */

/*
Remove the tiny gap/rounded notch visible under the first Overlay tab:
the active tab remains rounded, while the content pane starts with a
square top-left corner directly underneath it.
*/
QWidget#page3DView QTabWidget#tabWidget3D::pane,
QWidget#pageObliqueSlices QTabWidget#tabWidget::pane {
    background-color: #0E1018;
    border: 1px solid #252834;
    border-top-left-radius: 0px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
    top: 0px;
}

/* Save project (force-save) button, under the Patient ID card.
   Neutral at rest, rose outline on hover, and a permanent rose outline
   while the in-memory project matches the saved file (property saved="true"). */

/* User guide button, at the foot of the menu just above the logos:
   same neutral card, rose on hover. It speaks of the application and
   not of the patient, so it sits apart from the project block. */


/* ===============================================================
   FILES LOAD/SAVE STATES + REGULAR NAVIGATION - final refinement
   =============================================================== */

/* Loaded inputs: no gradient, only a permanent validation outline. */
QPushButton[uiRole="loadFile"][loaded="true"] {
    color: #F1F2F6;
    background-color: #12141C;
    border: 1px solid #FF487D;
}
QPushButton[uiRole="loadFile"][loaded="true"]:hover {
    color: white;
    background-color: #151720;
    border: 1px solid #FF487D;
}

/* Validated outputs remain neutral until hovered or actually saved. */
QPushButton[uiRole="saveAction"]:enabled {
    color: #F1F2F6;
    background-color: #12141C;
    border: 1px solid #343844;
}
QPushButton[uiRole="saveAction"]:enabled:hover {
    color: white;
    background-color: #171923;
    border: 1px solid #FF487D;
}
QPushButton[uiRole="saveAction"][saved="true"],
QPushButton[uiRole="saveAction"][saved="true"]:enabled {
    color: #F1F2F6;
    background-color: #12141C;
    border: 1px solid #FF487D;
}
QPushButton[uiRole="saveAction"][saved="true"]:hover {
    color: white;
    background-color: #171923;
    border: 1px solid #FF487D;
}

/* Save all validated deliberately keeps the existing gradient when available. */

