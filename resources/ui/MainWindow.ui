/* ===============================================================
   MAIN WINDOW - CUSTOM CHROME AND SIDEBAR LOGO
   =============================================================== */
QWidget#Form {
    background-color: #06070D;
    border: 1px solid #FF487D;
    border-radius: 16px;
}
QWidget#Form[maximized="true"] {
    border: none;
    border-radius: 0px;
}
QFrame#customTitleBar {
    background-color: #06070D;
    border: none;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
}
QWidget#Form[maximized="true"] QFrame#customTitleBar {
    border-radius: 0px;
}
QLabel#lbl_windowTitle {
    color: #757A8C;
    background-color: transparent;
    border: none;
}
QPushButton[uiRole="windowControl"] {
    color: #D8DAE4;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    min-width: 38px;
    max-width: 38px;
    min-height: 34px;
    max-height: 34px;
    font-size: 17px;
    font-weight: 500;
    padding: 0px;
}
QPushButton#btn_window_minimize:hover,
QPushButton#btn_window_maximize:hover {
    color: white;
    border: 1px solid #FF487D;
    background-color: #171923;
}
QPushButton#btn_window_close:hover {
    color: white;
    border: none;
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #FF8000,
        stop:1 #FF00A0
    );
}
QPushButton[uiRole="windowControl"]:pressed {
    background-color: #252834;
}


/* ===============================================================
   PATIENT DATA - CLINICAL STEP WORKFLOW FINAL STATES
   =============================================================== */

/* Loaded inputs remain dark; their pink border confirms availability. */
QWidget#pageFiles QPushButton[uiRole="loadFile"][loaded="true"] {
    color: #F2F2F5;
    background-color: #12141C;
    border: 1px solid #FF487D;
}
QWidget#pageFiles QPushButton[uiRole="loadFile"][loaded="true"]:hover {
    color: white;
    background-color: #171923;
    border: 1px solid #FF6BA0;
}

/* Reviewed/validated actions remain dark with a persistent pink outline. */
QWidget#pageFiles QPushButton[uiRole="reviewAction"][completed="true"] {
    color: #F2F2F5;
    background-color: #12141C;
    border: 1px solid #FF487D;
}
QWidget#pageFiles QPushButton[uiRole="reviewAction"][completed="true"]:hover {
    color: white;
    background-color: #171923;
    border: 1px solid #FF487D;
}

/* Individual output buttons never receive the gradient. */
QWidget#pageFiles QPushButton[uiRole="saveAction"]:enabled {
    color: #F1F2F6;
    background-color: #12141C;
    border: 1px solid #343844;
}
QWidget#pageFiles QPushButton[uiRole="saveAction"]:enabled:hover {
    color: white;
    background-color: #171923;
    border: 1px solid #FF487D;
}
QWidget#pageFiles QPushButton[uiRole="saveAction"][saved="true"],
QWidget#pageFiles QPushButton[uiRole="saveAction"][saved="true"]:enabled {
    color: #F1F2F6;
    background-color: #12141C;
    border: 1px solid #FF487D;
}

/* Save all is deliberately the sole gradient action once export is possible. */
QWidget#pageFiles QPushButton[uiRole="saveAllAction"]:enabled {
    color: white;
    border: none;
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #FF8000,
        stop:1 #FF00A0
    );
}
QWidget#pageFiles QPushButton[uiRole="saveAllAction"]:enabled:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #FF922B,
        stop:1 #FF33B8
    );
}

/* Progress is gradient, but softened to 75 percent opacity. */
QWidget#pageFiles QProgressBar[uiRole="workflowProgress"]::chunk {
    border-radius: 8px;
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(255, 128, 0, 191),
        stop:1 rgba(255, 0, 160, 191)
    );
}

/* ===============================================================
   OBLIQUE SLICE - ROSE OUTLINED ACTIVE TAB, NO GRADIENT
   =============================================================== */
QWidget#page3DView QTabWidget#tabWidget3D QTabBar::tab,
QWidget#pageObliqueSlices QTabWidget#tabWidget QTabBar::tab {
    color: #9599AA;
    background-color: #11131B;
    border: 1px solid #252834;
    border-bottom: none;
}
QWidget#page3DView QTabWidget#tabWidget3D QTabBar::tab:hover,
QWidget#pageObliqueSlices QTabWidget#tabWidget QTabBar::tab:hover {
    color: #FF7AA2;
    background-color: #151720;
    border: 1px solid #FF487D;
    border-bottom: none;
}
QWidget#page3DView QTabWidget#tabWidget3D QTabBar::tab:selected,
QWidget#pageObliqueSlices QTabWidget#tabWidget QTabBar::tab:selected {
    color: #FF7AA2;
    background-color: #151720;
    border: 1px solid #FF487D;
    border-bottom: none;
}


/* ===============================================================
   MINIMAL FINAL CORRECTIONS - MENU TYPOGRAPHY AND T1 REFERENCE
   =============================================================== */

/* Logo placed above MULTIMODAL ELECTRODE HUB. */

/* Same visual language as the clinical workflow section titles. */

/*
Step 2 - T1 is the fixed reference.
Only the checkbox indicator is highlighted after T1 is available:
the full T1 row must stay dark.
*/
QWidget#pageFiles QCheckBox[uiRole="referenceCheck"][referenceLoaded="true"] {
    color: #F2F2F5;
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 5px 0px;
}
QWidget#pageFiles QCheckBox[uiRole="referenceCheck"][referenceLoaded="true"]::indicator {
    border: 1px solid #FF487D;
    border-radius: 5px;
    background-color: #151720;
}
QWidget#pageFiles QCheckBox[uiRole="referenceCheck"][referenceLoaded="true"]::indicator:checked {
    border: 1px solid #FF487D;
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #FF8000,
        stop:1 #FF00A0
    );
}


/* Reconstruction view orientation buttons: selected = grey + persistent pink border. */
QWidget#pageReconstruction QPushButton#btn_radiologicView:hover,
QWidget#pageReconstruction QPushButton#btn_researchView:hover {
    border: 1px solid #FF487D;
}
QWidget#pageReconstruction QPushButton#btn_radiologicView:checked,
QWidget#pageReconstruction QPushButton#btn_researchView:checked,
QWidget#pageReconstruction QPushButton#btn_radiologicView:checked:hover,
QWidget#pageReconstruction QPushButton#btn_researchView:checked:hover {
    background-color: #41434A;
    border: 1px solid #FF487D;
}


/* ---------- Patient data: workflow grouping ---------- */
QLabel#filesLoadGroupMRI,
QLabel#filesLoadGroupFunctional,
QLabel#filesLoadGroupLabels,
QLabel#filesLoadGroupSurfaces {
    color: #8B8FA0;
    background-color: transparent;
    border: none;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding-top: 8px;
    padding-bottom: 2px;
}



/* ===============================================================
   FILES/COREG - requested v2 cleanup
   =============================================================== */

/* Remove the small vertical grouping strokes beside load buttons. */
QWidget#pageFiles QFrame[fileCell="true"],
QFrame#btn_FilesCoreg_loadT1Cell,
QFrame#btn_FilesCoreg_loadT2Cell,
QFrame#btn_FilesCoreg_loadCTCell,
QFrame#btn_FilesCoreg_loadPETCell,
QFrame#btn_FilesCoreg_loadictalSPECTCell,
QFrame#btn_FilesCoreg_loadinterictalSPECTCell,
QFrame#btn_FilesCoreg_loadfMRICell,
QFrame#btn_FilesCoreg_loadSISCOMCell,
QFrame#btn_FilesCoreg_loadParcel1Cell,
QFrame#btn_FilesCoreg_loadParcel2Cell,
QFrame#btn_FilesCoreg_lhpialCell,
QFrame#btn_FilesCoreg_rhpialCell,
QFrame#btn_FilesCoreg_loadBrainMaskCell {
    background-color: transparent;
    border: none;
    border-left: none;
}

/* Patient data, checkboxes: checked = dark fill + pink border + white cross.
   This overrides the older gradient rules for T1 reference and modality checks. */
QWidget#pageFiles QCheckBox::indicator:checked,
QWidget#pageFiles QCheckBox[uiRole="referenceCheck"]::indicator:checked,
QWidget#pageFiles QCheckBox[uiRole="referenceCheck"][referenceLoaded="true"]::indicator:checked,
QWidget#pageFiles QCheckBox[uiRole="modalityCheck"]::indicator:checked {
    background-color: #151720;
    border: 1px solid #FF487D;
    border-radius: 5px;
    image: url(resources/images/neuxelec_checkbox_cross.svg);
}

QWidget#pageFiles QCheckBox::indicator:checked:hover,
QWidget#pageFiles QCheckBox[uiRole="referenceCheck"]::indicator:checked:hover,
QWidget#pageFiles QCheckBox[uiRole="referenceCheck"][referenceLoaded="true"]::indicator:checked:hover,
QWidget#pageFiles QCheckBox[uiRole="modalityCheck"]::indicator:checked:hover {
    background-color: #181A24;
    border: 1px solid #FF487D;
    image: url(resources/images/neuxelec_checkbox_cross.svg);
}

QWidget#pageFiles QCheckBox::indicator:checked:disabled,
QWidget#pageFiles QCheckBox[uiRole="referenceCheck"]::indicator:checked:disabled,
QWidget#pageFiles QCheckBox[uiRole="modalityCheck"]::indicator:checked:disabled {
    background-color: rgba(21, 23, 32, 130);
    border: 1px solid rgba(255, 72, 125, 125);
    image: url(resources/images/neuxelec_checkbox_cross.svg);
}

/* Slider inactive state: this is applied when the corresponding modality
   controls are disabled by Python after the modality checkbox is unchecked. */
QSlider::groove:horizontal:disabled {
    background-color: rgba(36, 39, 51, 125);
    border: none;
    border-radius: 3px;
}
QSlider::sub-page:horizontal:disabled {
    background-color: rgba(242, 242, 245, 125);
    border: none;
    border-radius: 3px;
}
QSlider::add-page:horizontal:disabled {
    background-color: rgba(36, 39, 51, 125);
    border: none;
    border-radius: 3px;
}
QSlider::handle:horizontal:disabled {
    background-color: rgba(242, 242, 245, 125);
    border: 1px solid rgba(214, 216, 226, 125);
    width: 14px;
    height: 14px;
    margin: -6px 0px;
    border-radius: 8px;
}

QSlider::groove:vertical:disabled {
    background-color: rgba(36, 39, 51, 125);
    border: none;
    border-radius: 3px;
}
QSlider::sub-page:vertical:disabled {
    background-color: rgba(242, 242, 245, 125);
    border: none;
    border-radius: 3px;
}
QSlider::add-page:vertical:disabled {
    background-color: rgba(36, 39, 51, 125);
    border: none;
    border-radius: 3px;
}
QSlider::handle:vertical:disabled {
    background-color: rgba(242, 242, 245, 125);
    border: 1px solid rgba(214, 216, 226, 125);
    width: 14px;
    height: 14px;
    margin: 0px -6px;
    border-radius: 8px;
}


/* ============================================================
   FINAL REQUESTED OVERRIDES - menu, reconstruction scrolls, grid
   ============================================================ */

/* Left menu: active page = grey fill + persistent pink outline, no gradient. */

/* Reconstruction page: all visible scroll controls must read as scrollbars,
   not as color scales. */

/* Oblique slice plane scrollbars too: grey with pink outline, not gradient. */

/* Remove native blue selection/focus artefacts in electrode trees. */
QTreeWidget#tv_Electrodes {
    outline: none;
    selection-background-color: transparent;
    selection-color: #F2F2F5;
}
QTreeWidget#tv_Electrodes::item:selected,
QTreeWidget#tv_Electrodes::item:selected:active,
QTreeWidget#tv_Electrodes::item:selected:!active {
    background-color: transparent;
    border: none;
}
QTreeWidget#tv_Electrodes::branch:selected,
QTreeWidget#tv_Electrodes::branch:selected:active,
QTreeWidget#tv_Electrodes::branch:selected:!active,
QTreeWidget#tv_Electrodes::branch:open:has-children:selected,
QTreeWidget#tv_Electrodes::branch:closed:has-children:selected {
    background-color: transparent;
    border: none;
}

/* Reconstruction grid cells: keep a clean, symmetric 2 × 2 feel. */
QWidget#pageReconstruction QFrame#frame_25,
QWidget#pageReconstruction QFrame#frameReco_coronal,
QWidget#pageReconstruction QFrame#frameReco_sagittal,
QWidget#pageReconstruction QFrame#frameReco_axial {
    min-width: 0px;
    min-height: 0px;
}

/* ===============================================================
   GLOBAL OVERRIDE - SCROLLBARS GRAY WITH PINK OUTLINE ON ALL PAGES
   Only scrollbar visuals are overridden here.
   =============================================================== */

/* Generic scrollbar tracks */

/* Generic scrollbar handles */

/* Remove native arrows/pages everywhere */

/* Higher-specificity overrides for pages that already had dedicated scrollbar rules. */


/* ===============================================================
   PATIENT DATA - BULK IMPORT + STATUS OVERVIEW
   =============================================================== */
QFrame[uiRole="statusGroupCard"] {
    background-color: #0D0F16;
    border: 1px solid #252936;
    border-radius: 12px;
}
QLabel[uiRole="statusGroupTitle"] {
    color: #F4D9D0;
    background-color: transparent;
    border: none;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
}
QLabel[uiRole="statusSubGroup"] {
    color: #7E8294;
    background-color: transparent;
    border: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.1px;
    padding-top: 4px;
    padding-left: 2px;
}
QLabel[uiRole="statusPill"] {
    color: #525764;
    font-size: 15px;
    font-weight: 900;
    padding-left: 2px;
    padding-right: 2px;
}
QLabel[uiRole="statusPill"][status="loaded"] { color: #3FA7FF; }
QLabel[uiRole="statusPill"][status="validated"] { color: #42D67A; }
QLabel[uiRole="statusPill"][status="warning"] { color: #3FA7FF; }
QLabel[uiRole="statusPill"][status="missing"] { color: #525764; }
QLabel[uiRole="statusName"] {
    color: #D7D9E3;
    font-size: 13px;
    font-weight: 600;
}
QLabel[uiRole="statusText"] {
    color: #737887;
    font-size: 12px;
    font-weight: 600;
}
QLabel[uiRole="statusText"][status="loaded"] { color: #3FA7FF; }
QLabel[uiRole="statusText"][status="validated"] { color: #42D67A; }
QLabel[uiRole="statusText"][status="warning"] { color: #3FA7FF; }
QLabel[uiRole="statusText"][status="missing"] { color: #737887; }



/* ===============================================================
   OBLIQUE SLICES: larger sliders and spin arrows

   This panel is driven while reading the two slices, not while
   reading itself: the eye is on the image and the hand reaches for
   the control. A 5 px groove and a 9 px arrow ask for precision the
   gesture does not have, so both grow here. The palette does not
   change, only the geometry.
   =============================================================== */

/* The handle is drawn 20 px tall, so the widget must offer at least
   that much or Qt clips it top and bottom and the circle becomes a
   rounded rectangle. The .ui gave these sliders 15 px. */
QWidget#pageObliqueSlices QSlider:horizontal {
    min-height: 22px;
}

QWidget#pageObliqueSlices QSlider::groove:horizontal {
    height: 8px;
    background-color: #242733;
    border: none;
    border-radius: 4px;
}

QWidget#pageObliqueSlices QSlider::sub-page:horizontal {
    background-color: #F2F2F5;
    border: none;
    border-radius: 4px;
}

QWidget#pageObliqueSlices QSlider::add-page:horizontal {
    background-color: #242733;
    border: none;
    border-radius: 4px;
}

/* 18 px plus its 1 px border on each side makes 20 px drawn, so the
   radius is 10 and the margin lifts the handle by (20 - 8) / 2. */
QWidget#pageObliqueSlices QSlider::handle:horizontal {
    background-color: #F2F2F5;
    border: 1px solid #D6D8E2;
    width: 18px;
    height: 18px;
    margin: -6px 0px;
    border-radius: 10px;
}

QWidget#pageObliqueSlices QSlider::handle:horizontal:hover {
    border: 1px solid #FFFFFF;
}

QWidget#pageObliqueSlices QSlider::handle:horizontal:pressed {
    border: 2px solid #FF487D;
}

QWidget#pageObliqueSlices QSlider::groove:horizontal:disabled {
    background-color: rgba(36, 39, 51, 125);
    border: none;
    border-radius: 4px;
}

QWidget#pageObliqueSlices QSlider::sub-page:horizontal:disabled {
    background-color: rgba(242, 242, 245, 125);
    border: none;
    border-radius: 4px;
}

QWidget#pageObliqueSlices QSlider::add-page:horizontal:disabled {
    background-color: rgba(36, 39, 51, 125);
    border: none;
    border-radius: 4px;
}

QWidget#pageObliqueSlices QSlider::handle:horizontal:disabled {
    background-color: rgba(242, 242, 245, 125);
    border: 1px solid rgba(214, 216, 226, 125);
    width: 18px;
    height: 18px;
    margin: -6px 0px;
    border-radius: 10px;
}

/* The box grows with its buttons, and the right padding keeps the
   number clear of them. */
QWidget#pageObliqueSlices QSpinBox,
QWidget#pageObliqueSlices QDoubleSpinBox {
    min-height: 36px;
    padding: 3px 30px 3px 10px;
}

QWidget#pageObliqueSlices QSpinBox::up-button,
QWidget#pageObliqueSlices QDoubleSpinBox::up-button {
    width: 24px;
}

QWidget#pageObliqueSlices QSpinBox::down-button,
QWidget#pageObliqueSlices QDoubleSpinBox::down-button {
    width: 24px;
}

/* The two chevrons are 12x8 SVGs: drawn at that size they stay sharp,
   where 9x6 both shrank and blurred them. */
QWidget#pageObliqueSlices QSpinBox::up-arrow,
QWidget#pageObliqueSlices QDoubleSpinBox::up-arrow,
QWidget#pageObliqueSlices QSpinBox::down-arrow,
QWidget#pageObliqueSlices QDoubleSpinBox::down-arrow {
    width: 12px;
    height: 8px;
}

QWidget#pageObliqueSlices QSpinBox::up-arrow:disabled,
QWidget#pageObliqueSlices QDoubleSpinBox::up-arrow:disabled,
QWidget#pageObliqueSlices QSpinBox::down-arrow:disabled,
QWidget#pageObliqueSlices QDoubleSpinBox::down-arrow:disabled {
    width: 12px;
    height: 8px;
}

/* ===============================================================
   SLICE BARS: oblique rotation, and reconstruction slices

   These are not scrollbars through a document: they carry an angle
   that wraps, and each end is a step of one degree. They are read
   from the corner of the eye while the slice is being watched, so
   the bar is wider, the handle is a capsule, and both ends show the
   arrow that acts on them. The arrows come back from under the
   global "no native arrows" override by id.
   =============================================================== */

/* Half of 14 px: the handle reads as a capsule, not a tile. */

/* ===============================================================
   RECONSTRUCTION: a tighter ELECTRODE PARAMETERS card

   The card held twelve rows for the height of eight. Merging the
   rows was not enough: every field claims 33 px from the global
   input rule, which is comfortable in a settings panel and too much
   in a column read beside three CT views. Here they take 26, which
   still clears the text, and the card fits without scrolling.
   =============================================================== */

QWidget#pageReconstruction QLineEdit,
QWidget#pageReconstruction QComboBox {
    min-height: 26px;
    padding: 0px 8px;
}


/* ===============================================================
   Page Files: la console

   Une feuille, un en-tete, cinq tuiles de meme taille, et dessous le
   cockpit en deux colonnes. Les sections ne sont pas encadrees: elles
   se distinguent par leur fond, ce qui segmente sans ajouter dix
   traits de plus. Tout ce qui habille la page est ici, et nulle part
   ailleurs.
   =============================================================== */
QFrame#filesSheet {
    background-color: #0D0F15;
    border: 1px solid #1F222D;
    border-radius: 18px;
}
QWidget#pageFiles QFrame[filesTile="true"] {
    background-color: #12141C;
    border: 1px solid transparent;
    border-radius: 12px;
}
/* L'etape ou l'on en est: une tuile un ton plus clair, et son numero
   en rose. Pas de cadre: un cadre rose autour d'un rectangle enferme
   l'etape au lieu de la designer. */
QWidget#pageFiles QFrame[filesTile="true"][current="true"] {
    background-color: #191C26;
}
QWidget#pageFiles QFrame[uiRole="statusGroupCard"] {
    background-color: #12141C;
    border: none;
    border-radius: 12px;
}
QWidget#pageFiles QFrame#cardFilesStatusOverview {
    background-color: transparent;
    border: none;
    border-radius: 0;
}

/* --- l'en-tete */
QWidget#pageFiles QLabel#filesPatientName {
    color: #ECEDF1;
    font-size: 19px;
    font-weight: 600;
    background-color: transparent;
    border: none;
}
QWidget#pageFiles QLabel#filesSummaryLine {
    color: #878C9C;
    font-size: 12px;
    background-color: transparent;
    border: none;
}

/* --- les cinq tuiles */
QWidget#pageFiles QLabel[uiRole="stepKicker"] {
    color: #555A69;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.6px;
    background-color: transparent;
    border: none;
}
QWidget#pageFiles QLabel[uiRole="stepKicker"][current="true"] {
    color: #FF487D;
}
QWidget#pageFiles QLabel[uiRole="tileTitle"] {
    color: #ECEDF1;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0px;
    padding: 0px;
    margin: 0px;
    background-color: transparent;
    border: none;
}
QWidget#pageFiles QLabel[uiRole="tileState"] {
    color: #878C9C;
    font-size: 11px;
    padding: 0px;
    margin: 0px;
    background-color: transparent;
    border: none;
}
QWidget#pageFiles QFrame[filesTile="true"] QPushButton {
    color: #ECEDF1;
    background-color: #171A23;
    border: 1px solid #1F222D;
    border-radius: 8px;
    min-height: 28px;
    max-height: 30px;
    padding: 0px 12px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0px;
}
QWidget#pageFiles QFrame[filesTile="true"] QPushButton:disabled {
    color: #555A69;
    background-color: #12141C;
    border: 1px solid #191C25;
}
QWidget#pageFiles QFrame[filesTile="true"] QPushButton:hover:enabled {
    background-color: #1C202B;
}

/* Le contour rose porte l'action principale de l'etape, celle qui
   ouvre la fenetre ou lance le calcul. */
QWidget#pageFiles QFrame[filesTile="true"] QPushButton[uiRole="loadFile"]:enabled,
QWidget#pageFiles QFrame[filesTile="true"] QPushButton[uiRole="saveAction"]:enabled,
QWidget#pageFiles QFrame[filesTile="true"] QPushButton#btn_FilesCoreg_performCoreg:enabled {
    border: 1px solid #FF487D;
}
QWidget#pageFiles QFrame[filesTile="true"] QPushButton[uiRole="reviewAction"] {
    color: #878C9C;
    background-color: transparent;
    border: 1px solid #1F222D;
}
QWidget#pageFiles QFrame[filesTile="true"] QPushButton[uiRole="reviewAction"]:disabled {
    color: #555A69;
}
QWidget#pageFiles QFrame[filesTile="true"] QProgressBar {
    min-height: 16px;
    max-height: 18px;
    border-radius: 8px;
    font-size: 9px;
}
QWidget#pageFiles QFrame[filesTile="true"] QProgressBar::chunk {
    border-radius: 7px;
}

/* --- le cockpit */
QWidget#pageFiles QLabel[uiRole="statusGroupTitle"] {
    color: #FF487D;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.8px;
    background-color: transparent;
    border: none;
}
QWidget#pageFiles QLabel[uiRole="statusSubGroup"] {
    color: #8A90A0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.2px;
    padding: 0px;
    background-color: transparent;
    border: none;
}
QWidget#pageFiles QLabel[uiRole="statusColHead"] {
    color: #555A69;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.1px;
    background-color: transparent;
    border: none;
}
QWidget#pageFiles QLabel[uiRole="statusName"] {
    color: #ECEDF1;
    font-size: 14px;
    font-weight: 400;
    background-color: transparent;
    border: none;
}
QWidget#pageFiles QLabel[uiRole="statusName"][status="off"],
QWidget#pageFiles QLabel[uiRole="statusName"][status="missing"] {
    color: #555A69;
}
QWidget#pageFiles QLabel[uiRole="statusText"] {
    color: #878C9C;
    font-size: 13px;
    font-weight: 400;
    background-color: transparent;
    border: none;
}

/* Les quatre colonnes de l'imagerie. Vert: fait. Orange: a faire.
   Cercle vide: rien de charge. Point gris: sans objet pour cette
   ligne. Rose: c'est la reference. */
QWidget#pageFiles QLabel[uiRole="statusMark"] {
    color: #4A4F5C;
    font-size: 12px;
    font-weight: 900;
    background-color: transparent;
    border: none;
}
QWidget#pageFiles QLabel[uiRole="statusMark"][status="done"] { color: #4ED07A; }
QWidget#pageFiles QLabel[uiRole="statusMark"][status="todo"] { color: #FFA23A; }
QWidget#pageFiles QLabel[uiRole="statusMark"][status="off"] { color: #4A4F5C; }
QWidget#pageFiles QLabel[uiRole="statusMark"][status="na"] { color: #343842; }


/* ===============================================================
   Menu de gauche: le relief

   Trois cadres se suivaient avant le premier bouton, et six blocs de
   style se recouvraient plus bas. Il reste un cadre, le panneau, et un
   seul bloc, celui-ci.
   =============================================================== */
QFrame#menu {
    background-color: #0B0D13;
    border: 1px solid #1C1F29;
    border-radius: 16px;
}
QFrame#menu QLabel#appTitle {
    background: transparent;
    border: none;
}
QFrame#menu QLabel#appSubtitle {
    color: #555A69;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.6px;
    background: transparent;
    border: none;
    padding: 0px;
}

/* Le nom du patient est le titre de la fenetre: ni etiquette, ni cadre,
   seulement sa taille. */
QFrame#menu QLineEdit#le_menu_patientID {
    color: #ECEDF1;
    background: transparent;
    border: none;
    padding: 0px;
    font-size: 20px;
    font-weight: 600;
    selection-background-color: #FF487D;
}
QFrame#menu QLabel#menuProjectState {
    color: #878C9C;
    font-size: 11px;
    background: transparent;
    border: none;
}
QFrame#menu QLabel#menuProjectState[saved="true"] {
    color: #4ED07A;
}
QFrame#menu QFrame[menuRule="true"] {
    background-color: #191C25;
    border: none;
}
QFrame#menu QLabel#menuPagesLabel {
    color: #555A69;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.4px;
    background: transparent;
    border: none;
}

/* Les quatre pages sont des touches qui sortent: un filet clair en haut,
   une arete sombre en bas. Celle qui est ouverte s'enfonce, et son nom
   passe au rose. */
QFrame#menu QPushButton#btn_menu_fileCoreg,
QFrame#menu QPushButton#btn_menu_reconstruction,
QFrame#menu QPushButton#btn_menu_obliqueSlice,
QFrame#menu QPushButton#btn_menu_3Dview {
    color: #ECEDF1;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #181C26, stop:1 #12151D);
    border: none;
    border-top: 1px solid #2A2F3C;
    border-bottom: 2px solid #05060A;
    border-radius: 9px;
    padding: 0px 12px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
}
QFrame#menu QPushButton#btn_menu_fileCoreg:hover,
QFrame#menu QPushButton#btn_menu_reconstruction:hover,
QFrame#menu QPushButton#btn_menu_obliqueSlice:hover,
QFrame#menu QPushButton#btn_menu_3Dview:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1D212C, stop:1 #161A23);
}
QFrame#menu QPushButton#btn_menu_fileCoreg:checked,
QFrame#menu QPushButton#btn_menu_reconstruction:checked,
QFrame#menu QPushButton#btn_menu_obliqueSlice:checked,
QFrame#menu QPushButton#btn_menu_3Dview:checked,
QFrame#menu QPushButton#btn_menu_fileCoreg:checked:hover,
QFrame#menu QPushButton#btn_menu_reconstruction:checked:hover,
QFrame#menu QPushButton#btn_menu_obliqueSlice:checked:hover,
QFrame#menu QPushButton#btn_menu_3Dview:checked:hover {
    color: #FF487D;
    background: #0E1017;
    border: none;
    border-top: 2px solid #05060A;
    border-bottom: 1px solid #2A2F3C;
    font-weight: 600;
}

/* Les deux actions ne sont pas des pages: pas de relief, un contour. */
QFrame#menu QPushButton#btn_menu_saveProject,
QFrame#menu QPushButton#btn_menu_userGuide {
    color: #878C9C;
    background: transparent;
    border: 1px solid #262B38;
    border-radius: 9px;
    padding: 0px 12px;
    text-align: left;
    font-size: 12px;
    font-weight: 500;
}
QFrame#menu QPushButton#btn_menu_saveProject:hover,
QFrame#menu QPushButton#btn_menu_userGuide:hover {
    color: #ECEDF1;
    background: #11141C;
}
/* Le contour rose dit que le fichier sur le disque est a jour. */
QFrame#menu QPushButton#btn_menu_saveProject[saved="true"] {
    color: #ECEDF1;
    border: 1px solid #FF487D;
}
