/* ---------------------------------------------------------------
   Clean spin boxes and SVG buttons - no protruding native arrows
   If your real folder is named "resources", replace "ressources" below.
   --------------------------------------------------------------- */
QWidget#pageObliqueSlices QSpinBox,
QWidget#pageObliqueSlices QDoubleSpinBox {
    color: #F2F2F5;
    background-color: #151720;
    border: 1px solid #2B2D38;
    border-radius: 7px;
    min-height: 30px;
    padding: 3px 24px 3px 8px;
    selection-background-color: #FF487D;
    selection-color: white;
}
QWidget#pageObliqueSlices QSpinBox:hover,
QWidget#pageObliqueSlices QDoubleSpinBox:hover {
    border: 1px solid #3B3D48;
}
QWidget#pageObliqueSlices QSpinBox:focus,
QWidget#pageObliqueSlices QDoubleSpinBox:focus {
    border: 1px solid #FF487D;
    background-color: #181A24;
}
QWidget#pageObliqueSlices QSpinBox::up-button,
QWidget#pageObliqueSlices QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 19px;
    background-color: #1D1F29;
    border: none;
    border-left: 1px solid #2B2D38;
    border-bottom: 1px solid #2B2D38;
    border-top-right-radius: 6px;
    margin: 1px 1px 0px 0px;
}
QWidget#pageObliqueSlices QSpinBox::down-button,
QWidget#pageObliqueSlices QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 19px;
    background-color: #1D1F29;
    border: none;
    border-left: 1px solid #2B2D38;
    border-bottom-right-radius: 6px;
    margin: 0px 1px 1px 0px;
}
QWidget#pageObliqueSlices QSpinBox::up-button:hover,
QWidget#pageObliqueSlices QDoubleSpinBox::up-button:hover,
QWidget#pageObliqueSlices QSpinBox::down-button:hover,
QWidget#pageObliqueSlices QDoubleSpinBox::down-button:hover {
    background-color: #282A34;
}
QWidget#pageObliqueSlices QSpinBox::up-arrow,
QWidget#pageObliqueSlices QDoubleSpinBox::up-arrow {
    image: url(resources/images/spin_up.svg);
    width: 9px;
    height: 6px;
}
QWidget#pageObliqueSlices QSpinBox::down-arrow,
QWidget#pageObliqueSlices QDoubleSpinBox::down-arrow {
    image: url(resources/images/spin_down.svg);
    width: 9px;
    height: 6px;
}

